# ============================================================
# Drishti - AI Revenue Recovery agent system
# Copy to `.env` (local dev) or `docker/.env.dev` (compose) and fill in.
# NEVER commit real secrets.
# ============================================================

# ---- Application ----
APP_NAME=Drishti
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*                   # comma-separated list, e.g. http://localhost:3000,https://app.drishti.ai

# ---- Security ----
SECRET_KEY=change-me-in-production   # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key
DRISHTI_API_KEYS=dev-key-1,dev-key-2

# ---- Database ----
# Local Postgres (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://drishti:drishti@localhost:5432/drishti
# Zero-dependency fallback for quick local runs:
# DATABASE_URL=sqlite:///./drishti.db

# ---- Redis cache ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ---- Encryption (Fernet key, base64) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Logging / audit ----
LOG_LEVEL=INFO
LOG_JSON=false
AUDIT_LOG_FILE=logs/audit.jsonl

# ---- Razorpay (test mode keys from dashboard -> Settings -> API Keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- Groq reasoning (agent reasoning; optional - rule engine used when absent) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# ---- SMS provider: twilio | sns | mock ----
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AWS_REGION=ap-south-1
SNS_SENDER_ID=DRISHTI

# ---- Email provider: sendgrid | ses | mock ----
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=recovery@drishti.ai
SES_FROM_EMAIL=recovery@drishti.ai

# ---- Voice / IVR provider: exotel | mock ----
VOICE_PROVIDER=mock
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_FROM_NUMBER=

# ---- CRM integration: webhook | salesforce | freshsales | mock ----
CRM_PROVIDER=mock
CRM_WEBHOOK_URL=
CRM_API_KEY=

# ---- ML models ----
MODEL_DIR=models
RISK_MODEL_PATH=                 # e.g. models/risk_scorer.joblib
CLASSIFIER_MODEL_PATH=           # e.g. models/recovery_classifier.joblib
DRIFT_THRESHOLD=0.2              # PSI threshold for concept-drift alerts

# ---- Business rules ----
HIGH_VALUE_THRESHOLD_INR=25000
NUDGE_WINDOW_HOURS=72
